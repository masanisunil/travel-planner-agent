# Copy this file to .env and replace the placeholders before starting Docker Compose.
# Keep this file private and never commit it.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
AVIATION_STACK_API_KEY=replace_with_your_aviationstack_api_key
TAVILY_API_KEY=replace_with_your_tavily_api_key

# Use a long, randomly generated hexadecimal password so it is URL-safe.
POSTGRES_PASSWORD=replace_with_a_random_64_character_hex_password

# Optional: Streamlit port on the EC2 host.
APP_PORT=8501
