# Copy this file to .env and replace the placeholders before starting Docker Compose.
# Keep this file private and never commit it.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
AVIATION_STACK_API_KEY=replace_with_your_aviationstack_api_key
TAVILY_API_KEY=replace_with_your_tavily_api_key

# The app safely URL-encodes this value; punctuation such as @ is supported.
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Replace with this EC2 instance's public IPv4, followed by .sslip.io.
# Example: 44.202.146.158.sslip.io
APP_DOMAIN=YOUR_EC2_PUBLIC_IP.sslip.io
